# ─────────────────────────────────────────────────────────────────────────────
# Site configuration. For local development `pnpm dev` writes .env.local for
# you — you only need this file when deploying the site to Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ── mode ─────────────────────────────────────────────────────────────────────
# DEMO: no contract needed. Minting off, mint panel CLOSED, output page reads
# "closed till post mint", nothing touches the chain. LIVE (default): the real
# site, and everything below applies.
MODE=LIVE

# ── chain ────────────────────────────────────────────────────────────────────
# 1 = mainnet, 11155111 = sepolia, 31337 = anvil
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── RPC ──────────────────────────────────────────────────────────────────────
# Server-side only. The browser talks to /api/rpc, which forwards to Alchemy,
# so this key is never in the client bundle. `ALCHEMY_NETWORK` must match
# NEXT_PUBLIC_CHAIN_ID: eth-mainnet | eth-sepolia
ALCHEMY_API_KEY=
ALCHEMY_NETWORK=eth-sepolia

# Bypass the proxy and have the browser hit this URL directly. Only useful for
# the anvil loop, where there is no key to protect. Leaving it unset is correct
# for any real deployment.
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Overrides the Alchemy URL for the server-side proxy and the owner lookup.
# RPC_URL=

# ── assets ───────────────────────────────────────────────────────────────────
# From out/collection/upload.json after `pnpm upload`.
NEXT_PUBLIC_IMAGES_CID=
NEXT_PUBLIC_ART_CID=
NEXT_PUBLIC_IPFS_GATEWAY=https://4everland.io/ipfs

# Must match the seed the collection was generated with, or the site will
# render different art than was minted.
NEXT_PUBLIC_MASTER_SEED=CUBIC-SYMMETRY-ENGINE

# ── local development only ───────────────────────────────────────────────────
# Serves images/art/tokens.json from the local asset server instead of IPFS.
# NEXT_PUBLIC_LOCAL_ASSETS=http://127.0.0.1:8788
