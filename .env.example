# ─────────────────────────────────────────────────────────────────────────────
# Deployment secrets. Copy to `.env` and fill in. `.env` is gitignored.
# Only `pnpm deploy` and `pnpm upload` read this file — the local demo
# (`pnpm dev`) needs none of it.
# ─────────────────────────────────────────────────────────────────────────────

# Key that deploys and owns the contract on Sepolia/mainnet. Use a dedicated
# deployer, not a wallet holding funds you care about.
#
# This is NOT the anvil key that `pnpm dev` prints. That one is anvil's public
# test account, goes in your browser wallet, and is never read from here — the
# local loop and local deploy rehearsals both use it directly.
DEPLOYER_PRIVATE_KEY=0x

# All RPC goes through Alchemy. The deploy script builds the URL per network:
#   https://eth-sepolia.g.alchemy.com/v2/$ALCHEMY_API_KEY
#   https://eth-mainnet.g.alchemy.com/v2/$ALCHEMY_API_KEY
ALCHEMY_API_KEY=

# Overrides the Alchemy URL entirely if you would rather use another provider.
# RPC_URL=

# Contract verification on Etherscan. Without it the deploy still succeeds, it
# just leaves the source unverified.
ETHERSCAN_API_KEY=

# ── deploy defaults (the script prompts, these prefill the answers) ───────────
# CSE_OWNER=0x                  # defaults to the deployer
# CSE_PRICE_ETH=0.005
# CSE_ROYALTY=0x                # defaults to the owner
# CSE_ROYALTY_BPS=500           # 5%
# CSE_BASE_URI=ipfs://…/        # defaults to out/collection/upload.json

# ── generation ───────────────────────────────────────────────────────────────
# Changing this changes every token in the collection. Fix it before the real
# run and never touch it again.
CSE_MASTER_SEED=CUBIC-SYMMETRY-ENGINE

# ── 4EVERLAND (IPFS pinning) ─────────────────────────────────────────────────
# S3 credentials from the 4EVERLAND dashboard; the bucket must be IPFS-type.
FOUREVERLAND_KEY=
FOUREVERLAND_SECRET=
FOUREVERLAND_BUCKET=
# FOUREVERLAND_ENDPOINT=https://endpoint.4everland.co
# CSE_IPFS_GATEWAY=https://4everland.io/ipfs
